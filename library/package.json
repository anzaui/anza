{
  "name": "@adukiorg/anza",
  "version": "0.5.0",
  "description": "Anza web platform library — reactive state, networking, offline, animations, custom elements. Instant build step. Pure browser ESM.",
  "author": "fescii",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "homepage": "https://github.com/aduki-org/anza#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aduki-org/anza.git"
  },
  "keywords": [
    "anza",
    "esm",
    "web-components",
    "reactive",
    "offline",
    "animations",
    "no-build",
    "shadow-dom"
  ],
  "bin": {
    "anza": "./bin/anza/index.js",
    "anza-create": "./bin/create/index.js"
  },
  "files": [
    "src/",
    "types/",
    "schemas/",
    "importmap.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "bin/"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./schemas/anza.schema.json": "./schemas/anza.schema.json",
    "./schemas/vscode-json-schemas.json": "./schemas/vscode-json-schemas.json",
    "./schemas/anza.code-snippets": "./schemas/anza.code-snippets",
    "./api": {
      "types": "./types/core/api/index.d.ts",
      "default": "./src/core/api/index.js"
    },
    "./state": {
      "types": "./types/core/state/index.d.ts",
      "default": "./src/core/state/index.js"
    },
    "./events": {
      "types": "./types/core/events/index.d.ts",
      "default": "./src/core/events/index.js"
    },
    "./router": {
      "types": "./types/core/router/index.d.ts",
      "default": "./src/core/router/index.js"
    },
    "./storage": {
      "types": "./types/core/storage/index.d.ts",
      "default": "./src/core/storage/index.js"
    },
    "./offline": {
      "types": "./types/core/offline/index.d.ts",
      "default": "./src/core/offline/index.js"
    },
    "./animations": {
      "types": "./types/core/animations/index.d.ts",
      "default": "./src/core/animations/index.js"
    },
    "./workers": {
      "types": "./types/core/workers/index.d.ts",
      "default": "./src/core/workers/index.js"
    },
    "./security": {
      "types": "./types/core/security/index.d.ts",
      "default": "./src/core/security/index.js"
    },
    "./platform": {
      "types": "./types/core/platform/index.d.ts",
      "default": "./src/core/platform/index.js"
    },
    "./ui": {
      "types": "./types/core/ui/index.d.ts",
      "default": "./src/core/ui/index.js"
    },
    "./defs": {
      "default": "./src/core/ui/defs/index.js"
    },
    "./elements": {
      "types": "./types/elements/index.d.ts",
      "default": "./src/elements/index.js"
    },
    "./elements/button": "./src/elements/primitives/button/index.js",
    "./elements/icon": "./src/elements/primitives/icon/index.js",
    "./elements/badge": "./src/elements/primitives/badge/index.js",
    "./elements/avatar": "./src/elements/primitives/avatar/index.js",
    "./elements/divider": "./src/elements/primitives/divider/index.js",
    "./elements/text": "./src/elements/primitives/text/index.js",
    "./elements/link": "./src/elements/primitives/link/index.js",
    "./elements/spinner": "./src/elements/primitives/spinner/index.js",
    "./elements/input": "./src/elements/forms/input/index.js",
    "./elements/textarea": "./src/elements/forms/textarea/index.js",
    "./elements/select": "./src/elements/forms/select/index.js",
    "./elements/checkbox": "./src/elements/forms/checkbox/index.js",
    "./elements/radio": "./src/elements/forms/radio/index.js",
    "./elements/toggle": "./src/elements/forms/toggle/index.js",
    "./elements/field": "./src/elements/forms/field/index.js",
    "./elements/upload": "./src/elements/forms/upload/index.js",
    "./elements/form": "./src/elements/forms/form/index.js",
    "./elements/dialog": "./src/elements/overlay/dialog/index.js",
    "./elements/popover": "./src/elements/overlay/popover/index.js",
    "./elements/tooltip": "./src/elements/overlay/tooltip/index.js",
    "./elements/menu": "./src/elements/overlay/menu/index.js",
    "./elements/drawer": "./src/elements/overlay/drawer/index.js",
    "./elements/sheet": "./src/elements/overlay/sheet/index.js",
    "./elements/alert": "./src/elements/feedback/alert/index.js",
    "./elements/toast": "./src/elements/feedback/toast/index.js",
    "./elements/progress": "./src/elements/feedback/progress/index.js",
    "./elements/skeleton": "./src/elements/feedback/skeleton/index.js",
    "./elements/empty": "./src/elements/feedback/empty/index.js",
    "./elements/table": "./src/elements/data/table/index.js",
    "./elements/list": "./src/elements/data/list/index.js",
    "./elements/card": "./src/elements/data/card/index.js",
    "./elements/chart": "./src/elements/data/chart/index.js",
    "./elements/stat": "./src/elements/data/stat/index.js",
    "./elements/nav": "./src/elements/navigation/nav/index.js",
    "./elements/tabs": "./src/elements/navigation/tabs/index.js",
    "./elements/breadcrumb": "./src/elements/navigation/breadcrumb/index.js",
    "./elements/pagination": "./src/elements/navigation/pagination/index.js",
    "./elements/steps": "./src/elements/navigation/steps/index.js",
    "./elements/app": "./src/elements/layout/app/index.js",
    "./elements/header": "./src/elements/layout/header/index.js",
    "./elements/sidebar": "./src/elements/layout/sidebar/index.js",
    "./elements/stack": "./src/elements/layout/stack/index.js",
    "./elements/grid": "./src/elements/layout/grid/index.js",
    "./elements/split": "./src/elements/layout/split/index.js",
    "./elements/scroll": "./src/elements/layout/scroll/index.js",
    "./elements/surface": "./src/elements/layout/surface/index.js",
    "./styles/*": "./src/styles/*",
    "./tokens/*": "./src/tokens/*",
    "./sw": {
      "default": "./src/sw/index.js"
    },
    "./theme": {
      "types": "./types/core/theme/index.d.ts",
      "default": "./src/core/theme/index.js"
    },
    "./bin/create": {
      "default": "./bin/create/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npx @web/test-runner",
    "serve": "npx @web/dev-server --port 8080 --node-resolve false",
    "check": "tsc --noEmit -p tsconfig.json"
  }
}
